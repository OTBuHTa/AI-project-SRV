# Production deployment template.
#
# Copy this file to .env.production.
# Never commit .env.production.
#
# Do not activate APP_ENV=production until TLS termination
# is configured. After TLS is operational, set
# SECURE_HEADERS_HSTS_ENABLED=true.

APP_ENV=production
APP_NAME=AI-project SRV
API_HOST=0.0.0.0
API_PORT=8000

DATABASE_URL=postgresql+psycopg://aisrv:aisrv@postgres:5432/aisrv
REDIS_URL=redis://redis:6379/0

# Required: use at least 32 random bytes.
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14

BOOTSTRAP_ENABLED=false

# Required in production.
METRICS_BEARER_TOKEN=

# Keep false until HTTPS termination is working.
# Production preflight intentionally fails while false.
SECURE_HEADERS_HSTS_ENABLED=false

AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_RATE_LIMIT_IP_ATTEMPTS=20
AUTH_RATE_LIMIT_ACCOUNT_ATTEMPTS=10

LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=90

BACKUP_STORAGE_ROOT=/var/lib/ai-project-srv/backups
BACKUP_WORK_ROOT=/tmp/ai-project-srv-backups
BACKUP_STORAGE_BACKEND=local
BACKUP_NAS_ROOT=/mnt/ai-project-srv-backups
BACKUP_NAS_HOST_PATH=/mnt/nas/ai-project-srv/backups

# MikroTik RouterOS automation.
# Prefer a trusted certificate and a dedicated least-privilege account.
MIKROTIK_ENABLED=false
MIKROTIK_BASE_URL=https://192.168.88.1
MIKROTIK_USERNAME=
MIKROTIK_PASSWORD=
MIKROTIK_VERIFY_TLS=true
MIKROTIK_TIMEOUT_SECONDS=5
MIKROTIK_ALLOW_WRITE=false
MIKROTIK_WAN_INTERFACE=ether1
# Optional guard value. Store the real address only in .env.production.
MIKROTIK_EXPECTED_WAN_IP=

# Dedicated nginx proxy address.
FORWARDED_ALLOW_IPS=172.30.0.2

# TLS deployment profile.
# Replace these values before deployment.
AI_SRV_ENV_FILE=.env.production
AI_SRV_SERVER_NAME=replace-with-fqdn.example
AI_SRV_TLS_CERT_PATH=/absolute/path/to/fullchain.pem
AI_SRV_TLS_KEY_PATH=/absolute/path/to/privkey.pem
