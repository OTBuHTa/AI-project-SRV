APP_ENV=development
APP_NAME=AI-project SRV
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+psycopg://aisrv:aisrv@postgres:5432/aisrv
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-at-least-32-random-bytes-before-external-access
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
BOOTSTRAP_ENABLED=true

LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=qwen2.5:7b
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=90

# Backup pipeline
BACKUP_STORAGE_ROOT=/var/lib/ai-project-srv/backups
BACKUP_WORK_ROOT=/tmp/ai-project-srv-backups

# Backup storage backend
# local = Docker persistent volume
# nas   = host-mounted NAS filesystem
BACKUP_STORAGE_BACKEND=local
BACKUP_NAS_ROOT=/mnt/ai-project-srv-backups
BACKUP_NAS_HOST_PATH=/mnt/nas/ai-project-srv/backups

# Reverse proxy trust boundary.
# Set to the exact reverse-proxy IP or CIDR in production.
# Never use "*" on an Internet-reachable deployment.
FORWARDED_ALLOW_IPS=127.0.0.1
