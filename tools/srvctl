from __future__ import annotations

import argparse
import json
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
EXPECTED_SERVICES = {
    "postgres",
    "redis",
    "api",
    "web",
    "agent-lifecycle-alert-delivery",
    "backup-alert-delivery",
    "backup-scheduler",
}


def run(
    *cmd: str,
    check: bool = False,
    cwd: Path | None = None,
    env: dict[str, str] | None = None,
) -> subprocess.CompletedProcess[str]:
    import os

    process_env = os.environ.copy()

    if env:
        process_env.update(env)

    return subprocess.run(
        cmd,
        cwd=cwd or ROOT,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=check,
        env=process_env,
    )


def emit(payload: dict, json_mode: bool) -> int:
    if json_mode:
        print(json.dumps(payload, indent=2, ensure_ascii=False))
    else:
        for key, value in payload.items():
            if isinstance(value, (dict, list)):
                print(f"{key}={json.dumps(value, ensure_ascii=False)}")
            else:
                print(f"{key}={value}")

    return 0 if payload.get("ok") is True else 1


def git_status() -> dict:
    branch = run("git", "branch", "--show-current").stdout.strip()
    head = run("git", "rev-parse", "HEAD").stdout.strip()
    origin_main = run("git", "rev-parse", "origin/main").stdout.strip()
    dirty = run("git", "status", "--porcelain").stdout.splitlines()

    return {
        "branch": branch,
        "head": head,
        "origin_main": origin_main,
        "dirty": dirty,
    }


def compose_services() -> list[str]:
    result = run(
        "docker",
        "compose",
        "ps",
        "--services",
        "--status",
        "running",
    )

    if result.returncode != 0:
        return []

    return sorted(
        line.strip()
        for line in result.stdout.splitlines()
        if line.strip()
    )


def health() -> dict:
    health_result = run(
        "curl",
        "-fsS",
        "http://127.0.0.1:8000/health",
    )

    ready_result = run(
        "curl",
        "-fsS",
        "http://127.0.0.1:8000/ready",
    )

    web_result = run(
        "curl",
        "-sS",
        "-o",
        "/dev/null",
        "-w",
        "%{http_code}",
        "http://127.0.0.1:8080/",
    )

    def decode(result: subprocess.CompletedProcess[str]) -> dict | None:
        if result.returncode != 0:
            return None

        try:
            return json.loads(result.stdout)
        except json.JSONDecodeError:
            return None

    return {
        "health": decode(health_result),
        "ready": decode(ready_result),
        "web_http": web_result.stdout.strip(),
    }


def command_status(json_mode: bool) -> int:
    git = git_status()
    services = compose_services()
    runtime = health()

    payload = {
        "ok": (
            not git["dirty"]
            and set(services) == EXPECTED_SERVICES
            and runtime["health"] is not None
            and runtime["ready"] is not None
            and runtime["web_http"] == "200"
        ),
        "git": git,
        "services": services,
        "runtime": runtime,
    }

    return emit(payload, json_mode)


def command_doctor(json_mode: bool) -> int:
    checks = {}

    for binary in (
        "git",
        "docker",
        "curl",
        "python3",
    ):
        result = run(
            "bash",
            "-lc",
            f"command -v {binary}",
        )

        checks[binary] = result.returncode == 0

    compose = run(
        "docker",
        "compose",
        "version",
    )

    checks["docker_compose"] = compose.returncode == 0
    checks["env_exists"] = (ROOT / ".env").exists()

    payload = {
        "ok": all(checks.values()),
        "checks": checks,
    }

    return emit(payload, json_mode)


