def command_ci(json_mode: bool) -> int:
    snapshot = ci_snapshot()

    return emit(
        {
            "ok": snapshot["ok"],
            "checks": snapshot["checks"],
            "failures": {
                name: detail
                for name, detail
                in snapshot["details"].items()
                if detail["rc"] != 0
            },
        },
        json_mode,
    )


def command_autopilot(json_mode: bool) -> int:
    doctor = doctor_snapshot()
    ci = ci_snapshot()
    runtime = runtime_snapshot()
    git = git_status()

    checks = {
        "doctor": doctor["ok"],
        "ci": ci["ok"],
        "runtime": runtime["ok"],
    }

    payload = {
        "ok": all(checks.values()),
        "mode": "safe-autopilot",
        "checks": checks,
        "branch": git["branch"],
        "head": git["head"],
        "working_tree_clean": not git["dirty"],
        "runtime_version":
            runtime["health"].get("version"),
        "runtime_revision":
            runtime["health"].get(
                "build_revision"
            ),
        "next":
            (
                "production-gate"
                if all(checks.values())
                else "fix-failed-checks"
            ),
    }

    failures = {
        name: detail
        for name, detail
        in ci["details"].items()
        if detail["rc"] != 0
    }

    if failures:
        payload["ci_failures"] = failures

    return emit(
        payload,
        json_mode,
    )


def command_production_gate(
    json_mode: bool,
) -> int:
    git = git_status()
    runtime = runtime_snapshot()

    alembic = run(
        "docker",
        "compose",
        "exec",
        "-T",
        "api",
        "alembic",
        "current",
    )

    logs = run(
        "docker",
        "compose",
        "logs",
        "--since=10m",
        "--no-color",
    )

    log_text = (
        logs.stdout
        + "\n"
        + logs.stderr
    ).lower()

    critical_patterns = (
        "traceback",
        "fatal",
        "panic",
        "uncaught",
        "segmentation fault",
    )

    critical_logs = [
        pattern
        for pattern in critical_patterns
        if pattern in log_text
    ]

    environment = (
        runtime["health"].get("environment")
    )

    checks = {
        "main_branch":
            git["branch"] == "main",

        "clean_tree":
            not git["dirty"],

        "runtime":
            runtime["ok"],

        "production_environment":
            environment == "production",

        "alembic_head":
            (
                alembic.returncode == 0
                and
                "0021_worker_operational_state (head)"
                in alembic.stdout
            ),

        "critical_logs_none":
            not critical_logs,
    }

    blockers = [
        name
        for name, passed in checks.items()
        if not passed
    ]

    return emit(
        {
            "ok": all(checks.values()),
            "gate": "production",
            "checks": checks,
            "blockers": blockers,
            "environment": environment,
            "branch": git["branch"],
            "head": git["head"],
        },
        json_mode,
    )


STATE_DIR = ROOT / ".git" / "srvctl"
DEPLOY_STATE = STATE_DIR / "deploy-state.json"


def save_deploy_state(payload: dict) -> None:
    STATE_DIR.mkdir(
        parents=True,
        exist_ok=True,
    )

    DEPLOY_STATE.write_text(
        json.dumps(
            payload,
            indent=2,
            ensure_ascii=False,
        ),
        encoding="utf-8",
    )


def load_deploy_state() -> dict | None:
    if not DEPLOY_STATE.exists():
        return None

    try:
        return json.loads(
            DEPLOY_STATE.read_text(
                encoding="utf-8",
            )
        )
    except json.JSONDecodeError:
        return None


def deploy_preflight() -> dict:
    git = git_status()
    runtime = runtime_snapshot()

    env_file = ROOT / ".env"

    env_mode = None

    if env_file.exists():
        env_mode = oct(
            env_file.stat().st_mode & 0o777
        )[2:]

    checks = {
        "main_branch":
            git["branch"] == "main",

        "clean_tree":
            not git["dirty"],

        "head_matches_origin_main":
            git["head"] == git["origin_main"],

        "env_exists":
            env_file.exists(),

        "env_mode_600":
            env_mode == "600",

        "runtime_before_deploy":
            runtime["ok"],
    }

    return {
        "ok": all(checks.values()),
        "checks": checks,
        "git": git,
        "runtime": runtime,
        "env_mode": env_mode,
    }


def command_deploy_plan(
    json_mode: bool,
) -> int:
    preflight = deploy_preflight()

    current_revision = (
        preflight["runtime"]
        ["health"]
        .get("build_revision")
    )

    target_revision = (
        preflight["git"]["head"]
    )

    blockers = [
        name
        for name, passed
        in preflight["checks"].items()
        if not passed
    ]

    payload = {
        "ok": preflight["ok"],
        "action": "deploy-plan",
        "current_revision":
            current_revision,
        "target_revision":
            target_revision,
        "branch":
            preflight["git"]["branch"],
        "checks":
            preflight["checks"],
        "blockers":
            blockers,
        "would_run":
            (
                "docker compose up -d "
                "--build --remove-orphans"
            ),
    }

    return emit(
        payload,
        json_mode,
    )


def command_deploy(
    json_mode: bool,
) -> int:
    preflight = deploy_preflight()

    if not preflight["ok"]:
        blockers = [
            name
            for name, passed
            in preflight["checks"].items()
            if not passed
        ]

        return emit(
            {
                "ok": False,
                "action": "deploy",
                "executed": False,
                "blockers": blockers,
            },
            json_mode,
        )

    previous_revision = (
        preflight["runtime"]
        ["health"]
        .get("build_revision")
    )

    target_revision = (
        preflight["git"]["head"]
    )

    save_deploy_state(
        {
            "previous_revision":
                previous_revision,
            "target_revision":
                target_revision,
            "status":
                "deploying",
        }
    )

    result = run(
        "docker",
        "compose",
        "up",
        "-d",
        "--build",
        "--remove-orphans",
        cwd=ROOT,
        env={
            "AI_SRV_BUILD_REVISION":
                target_revision,
        },
    )

    if result.returncode != 0:
        save_deploy_state(
            {
                "previous_revision":
                    previous_revision,
                "target_revision":
                    target_revision,
                "status":
                    "deploy-failed",
                "error":
                    compact_process(result),
            }
        )

        return emit(
            {
                "ok": False,
                "action": "deploy",
                "executed": True,
                "phase": "compose-up",
                "result":
                    compact_process(result),
            },
            json_mode,
        )

    import time

    verified = False
    runtime = {}

    for _ in range(30):
        time.sleep(2)

        runtime = runtime_snapshot()

        revision = (
            runtime["health"]
            .get("build_revision")
        )

        if (
            runtime["ok"]
            and revision
            == target_revision
        ):
            verified = True
            break

    save_deploy_state(
        {
            "previous_revision":
                previous_revision,
            "target_revision":
                target_revision,
            "status":
                (
                    "verified"
                    if verified
                    else "verification-failed"
                ),
        }
    )

    return emit(
        {
            "ok": verified,
            "action": "deploy",
            "executed": True,
            "previous_revision":
                previous_revision,
            "target_revision":
                target_revision,
            "runtime":
                runtime,
            "rollback_required":
                not verified,
        },
        json_mode,
    )


def command_deploy_state(
    json_mode: bool,
) -> int:
    state = load_deploy_state()

    return emit(
        {
            "ok": state is not None,
            "action": "deploy-state",
            "state": state,
        },
        json_mode,
    )


def command_rollback_plan(
    json_mode: bool,
) -> int:
    state = load_deploy_state()

    if state is None:
        return emit(
            {
                "ok": False,
                "action":
                    "rollback-plan",
                "blockers": [
                    "deploy-state-missing",
                ],
            },
            json_mode,
        )

    previous_revision = (
        state.get("previous_revision")
    )

    target_revision = (
        state.get("target_revision")
    )

    commit_check = run(
        "git",
        "cat-file",
        "-e",
        f"{previous_revision}^{{commit}}",
    )

    checks = {
        "previous_revision_present":
            bool(previous_revision),

        "target_revision_present":
            bool(target_revision),

        "previous_commit_available":
            commit_check.returncode == 0,
    }

    blockers = [
        name
        for name, passed
        in checks.items()
        if not passed
    ]

    return emit(
        {
            "ok": all(checks.values()),
            "action": "rollback-plan",
            "from_revision":
                target_revision,
            "to_revision":
                previous_revision,
            "checks":
                checks,
            "blockers":
                blockers,
            "executed": False,
        },
        json_mode,
    )


def compose_project_name() -> str | None:
    result = run(
        "docker",
        "compose",
        "ps",
        "-q",
        "api",
    )

    if result.returncode != 0:
        return None

    container_id = result.stdout.strip()

    if not container_id:
        return None

    inspect = run(
        "docker",
        "inspect",
        "-f",
        '{{ index .Config.Labels "com.docker.compose.project" }}',
        container_id,
    )

    if inspect.returncode != 0:
        return None

    value = inspect.stdout.strip()

    return value or None


def find_compose_file(
    root: Path,
) -> Path | None:
    for name in (
        "compose.yaml",
        "compose.yml",
        "docker-compose.yaml",
        "docker-compose.yml",
    ):
        candidate = root / name

        if candidate.exists():
            return candidate

    return None


def command_rollback(
    json_mode: bool,
) -> int:
    import shutil
    import tempfile
    import time

    state = load_deploy_state()
    git = git_status()

    if state is None:
        return emit(
            {
                "ok": False,
                "action": "rollback",
                "executed": False,
                "blockers": [
                    "deploy-state-missing",
                ],
            },
            json_mode,
        )

    previous_revision = (
        state.get("previous_revision")
    )

    checks = {
        "main_branch":
            git["branch"] == "main",

        "clean_tree":
            not git["dirty"],

        "head_matches_origin_main":
            git["head"] == git["origin_main"],

        "previous_revision_present":
            bool(previous_revision),

        "rollback_required":
            state.get("status")
            in {
                "deploy-failed",
                "verification-failed",
            },

        "env_exists":
            (ROOT / ".env").exists(),
    }

    commit_check = None

    if previous_revision:
        commit_check = run(
            "git",
            "cat-file",
            "-e",
            f"{previous_revision}^{{commit}}",
        )

    checks["previous_commit_available"] = (
        commit_check is not None
        and commit_check.returncode == 0
    )

    project_name = compose_project_name()

    checks["compose_project"] = (
        project_name is not None
    )

    blockers = [
        name
        for name, passed
        in checks.items()
        if not passed
    ]

    if blockers:
        return emit(
            {
                "ok": False,
                "action": "rollback",
                "executed": False,
                "checks": checks,
                "blockers": blockers,
            },
            json_mode,
        )

    tmp_root = Path(
        tempfile.mkdtemp(
            prefix="ai-srv-rollback-",
        )
    )

    worktree = tmp_root / "repo"

    add_worktree = run(
        "git",
        "worktree",
        "add",
        "--detach",
        str(worktree),
        previous_revision,
    )

    if add_worktree.returncode != 0:
        shutil.rmtree(
            tmp_root,
            ignore_errors=True,
        )

        return emit(
            {
                "ok": False,
                "action": "rollback",
                "executed": False,
                "phase": "worktree",
                "result":
                    compact_process(add_worktree),
            },
            json_mode,
        )

    verified = False
    runtime = {}
    rollback_result = None

    try:
        compose_file = find_compose_file(
            worktree
        )

        if compose_file is None:
            save_deploy_state(
                {
                    **state,
                    "status":
                        "rollback-compose-missing",
                }
            )

            return emit(
                {
                    "ok": False,
                    "action": "rollback",
                    "executed": False,
                    "blockers": [
                        "compose-file-missing",
                    ],
                },
                json_mode,
            )

        rollback_result = run(
            "docker",
            "compose",
            "-p",
            project_name,
            "--env-file",
            str(ROOT / ".env"),
            "-f",
            str(compose_file),
            "up",
            "-d",
            "--build",
            "--remove-orphans",
            cwd=worktree,
            env={
                "AI_SRV_BUILD_REVISION":
                    previous_revision,
                "AI_SRV_ENV_FILE":
                    str(ROOT / ".env"),
            },
        )

        if rollback_result.returncode == 0:
            for _ in range(30):
                time.sleep(2)

                runtime = runtime_snapshot()

                revision = (
                    runtime["health"]
                    .get("build_revision")
                )

                if (
                    runtime["ok"]
                    and revision
                    == previous_revision
                ):
                    verified = True
                    break

        save_deploy_state(
            {
                **state,
                "status":
                    (
                        "rollback-verified"
                        if verified
                        else "rollback-failed"
                    ),
                "rollback_revision":
                    previous_revision,
            }
        )

    finally:
        run(
            "git",
            "worktree",
            "remove",
            "--force",
            str(worktree),
        )

        shutil.rmtree(
            tmp_root,
            ignore_errors=True,
        )

    return emit(
        {
            "ok": verified,
            "action": "rollback",
            "executed": True,
            "revision":
                previous_revision,
            "compose":
                (
                    None
                    if rollback_result is None
                    else
                    compact_process(
                        rollback_result
                    )
                ),
            "runtime":
                runtime,
        },
        json_mode,
    )


def command_release_gate(
    json_mode: bool,
) -> int:
    git = git_status()
    ci = ci_snapshot()

    merge_base = run(
        "git",
        "merge-base",
        "--is-ancestor",
        "origin/main",
        "HEAD",
    )

    changed_result = run(
        "git",
        "diff",
        "--name-only",
        "origin/main...HEAD",
    )

    changed = {
        line.strip()
        for line in
        changed_result.stdout.splitlines()
        if line.strip()
    }

    allowed = {
        "README.md",
        "tools/srvctl",
        "apps/api/app/version.py",
        "apps/api/pyproject.toml",
        "docs/RELEASE-v0.3.22-alpha.md",
    }

    version_file = (
        ROOT
        / "apps/api/app/version.py"
    ).read_text(
        encoding="utf-8"
    )

    pyproject = (
        ROOT
        / "apps/api/pyproject.toml"
    ).read_text(
        encoding="utf-8"
    )

    checks = {
        "release_branch":
            git["branch"]
            == "agent/v0.3.22-alpha",

        "clean_tree":
            not git["dirty"],

        "base_is_origin_main":
            merge_base.returncode == 0,

        "ci":
            ci["ok"],

        "expected_files_only":
            (
                bool(changed)
                and changed <= allowed
            ),

        "srvctl_changed":
            "tools/srvctl" in changed,

        "api_version":
            'API_VERSION = "0.3.22-alpha"'
            in version_file,

        "package_version":
            'version = "0.3.22a0"'
            in pyproject,

        "release_notes":
            (
                ROOT
                / "docs/RELEASE-v0.3.22-alpha.md"
            ).exists(),
    }

    blockers = [
        name
        for name, passed
        in checks.items()
        if not passed
    ]

    return emit(
        {
            "ok": all(checks.values()),
            "gate": "release",
            "release":
                "v0.3.22-alpha",
            "checks": checks,
            "changed_files":
                sorted(changed),
            "blockers":
                blockers,
        },
        json_mode,
    )

def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="srvctl",
        description="AI-project SRV operational control CLI",
    )

    parser.add_argument(
        "--json",
        action="store_true",
        help="machine-readable output",
    )

    sub = parser.add_subparsers(
        dest="command",
        required=True,
    )

    sub.add_parser("doctor")
    sub.add_parser("status")
    sub.add_parser("test")
    sub.add_parser("verify")
    sub.add_parser("ci")
    sub.add_parser("production-gate")
    sub.add_parser("autopilot")
    sub.add_parser("deploy-plan")
    sub.add_parser("deploy")
    sub.add_parser("deploy-state")
    sub.add_parser("rollback-plan")
    sub.add_parser("rollback")
    sub.add_parser("release-gate")

    return parser


def main() -> int:
    parser = build_parser()
    args = parser.parse_args()

    handlers = {
        "doctor": command_doctor,
        "status": command_status,
        "test": command_test,
        "verify": command_verify,
        "ci": command_ci,
        "production-gate": command_production_gate,
        "autopilot": command_autopilot,
        "deploy-plan": command_deploy_plan,
        "deploy": command_deploy,
        "deploy-state": command_deploy_state,
        "rollback-plan": command_rollback_plan,
        "rollback": command_rollback,
        "release-gate": command_release_gate,
    }

    return handlers[args.command](args.json)


if __name__ == "__main__":
    sys.exit(main())
